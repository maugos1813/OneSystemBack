# Servidor TCP de ingesta (donde el FMB204 debe conectarse)
TCP_PORT=5027
TCP_HOST=0.0.0.0

# API REST
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# Base de datos (Postgres + TimescaleDB + PostGIS)
# Port 5433 (not 5432): this project's docker-compose maps Postgres there to avoid
# clashing with any Postgres already installed natively on the host.
DATABASE_URL=postgres://onesystem:onesystem@localhost:5433/onesystem

# Auth
JWT_SECRET=change-me-in-production

# Comma-separated list of frontend origins allowed to call this API from a browser
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info
