# Servidor TCP de ingesta (donde el FMB204 debe conectarse)
TCP_PORT=5027
TCP_HOST=0.0.0.0

# API REST
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# Base de datos (Postgres + TimescaleDB + PostGIS)
# Port 5433 (not 5432): this project's docker-compose maps Postgres there to avoid
# clashing with any Postgres already installed natively on the host.
DATABASE_URL=postgres://onesystem:onesystem@localhost:5433/onesystem

# Auth
JWT_SECRET=change-me-in-production

# Comma-separated list of frontend origins allowed to call this API from a browser
CORS_ORIGIN=http://localhost:5173

# Public base URL of this API, shown as the server in the OpenAPI docs (/docs)
PUBLIC_API_URL=http://localhost:3000

LOG_LEVEL=info

# Email alerts (Resend — https://resend.com). Left unset, the alert scheduler still
# runs (idling/geofence state keeps ticking) but silently skips sending, which is fine
# for local dev.
# RESEND_API_KEY=re_...
# "OneSystem Alertas <onboarding@resend.dev>" works with no domain verification, but
# only reaches your own Resend account's email — verify a domain in Resend and switch
# this to something like "OneSystem <alertas@tu-dominio.com>" to reach real customers.
ALERT_EMAIL_FROM=OneSystem Alertas <onboarding@resend.dev>
# How often the background job re-checks every organization's alert conditions.
ALERT_EVAL_INTERVAL_MINUTES=5
